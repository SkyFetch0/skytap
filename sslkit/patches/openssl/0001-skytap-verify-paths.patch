+    if (ca && ca[0]) {
+        CAfile = ca;
+        CApath = NULL;
+    }
     if (CAfile == NULL && CApath == NULL)
         return 0;
     if (CAfile != NULL && !SSL_CTX_load_verify_file(ctx, CAfile))
         return 0;
     if (CApath != NULL && !SSL_CTX_load_verify_dir(ctx, CApath))
         return 0;
     return 1;
 }
 
